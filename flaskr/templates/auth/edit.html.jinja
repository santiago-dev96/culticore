{% extends 'layout.html.jinja' %}

{% block title %}

Edit account |&nbsp;

{% endblock %}

{% block content %}

<main>
  <h1 class="text-center">Edit account</h1>

  <div class="row justify-content-center">

    <div class="col-12 col-sm-9 col-md-6 col-lg-5 col-xl-4 col-xxl-3">

      <form class="p-3 mt-4 border rounded" action="{{ url_for('auth.edit_account', id=user['id']) }}" method="post">

        <div class="mb-5">
          <label for="username" class="form-label">Username <span class="text-danger">*</span></label>
          <input autofocus type="text" name="username" id="username" class="form-control" required value="{{ user['username'] }}">
        </div>

        <div class="d-grid">
          <button type="submit" class="btn btn-primary">Edit</button>
        </div>

      </form>

    </div>

  </div>
</main>

{% endblock %}